{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch PerceptionTests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-debug",
      "program": "${workspaceFolder}/src/PerceptionTests/bin/Debug/net8.0-windows/PerceptionTests.exe",
      "cwd": "${workspaceFolder}/src/PerceptionTests/bin/Debug/net8.0-windows",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
