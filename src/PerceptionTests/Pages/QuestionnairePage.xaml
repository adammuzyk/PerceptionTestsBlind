<pages:BasePage x:Class="PerceptionTests.Pages.QuestionnairePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:pages="clr-namespace:PerceptionTests.Pages"
                xmlns:viewModels="clr-namespace:PerceptionTests.ViewModels"
                xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                mc:Ignorable="d"
                d:DesignHeight="450"
                d:DesignWidth="700">
    <pages:BasePage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Width" Value="224" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="DimGray" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <Trigger Property="Text" Value="This field is required.">
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type viewModels:ChoiceFieldViewModel}">
            <Grid Margin="0,0,0,14"
                  Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="{Binding Label}" />
                <StackPanel Grid.Column="1">
                    <ItemsControl ItemsSource="{Binding OptionItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Margin="0,0,18,0"
                                             GroupName="{Binding DataContext.FieldId, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             Content="{Binding Label}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource HelpTextStyle}"
                               Text="{Binding HelpText}" />
                    <TextBlock Style="{StaticResource ValidationErrorStyle}"
                               Text="{Binding ValidationError}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:TextFieldViewModel}">
            <Grid Margin="0,0,0,14"
                  Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="{Binding Label}" />
                <StackPanel Grid.Column="1">
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             MinHeight="24"
                             AcceptsReturn="True" />
                    <TextBlock Style="{StaticResource HelpTextStyle}"
                               Text="{Binding HelpText}" />
                    <TextBlock Style="{StaticResource ValidationErrorStyle}"
                               Text="{Binding ValidationError}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:IntegerStepperFieldViewModel}">
            <Grid Margin="0,0,0,14"
                  Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="{Binding Label}" />
                <StackPanel Grid.Column="1">
                    <xctk:IntegerUpDown Width="96"
                                        HorizontalAlignment="Left"
                                        DefaultValue="{Binding DefaultValue}"
                                        Increment="{Binding Step}"
                                        Minimum="{Binding Minimum}"
                                        Maximum="{Binding Maximum}"
                                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource HelpTextStyle}"
                               Text="{Binding HelpText}" />
                    <TextBlock Style="{StaticResource ValidationErrorStyle}"
                               Text="{Binding ValidationError}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </pages:BasePage.Resources>

    <Grid Margin="16,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="QuestionnaireScrollViewer"
                      Grid.Row="0"
                      Padding="0,0,16,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,16,0,0"
                          Width="{Binding ElementName=QuestionnaireScrollViewer, Path=ViewportWidth}"
                          ItemsSource="{Binding Fields}" />
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0,0,16,0">
            <TextBlock Foreground="Red"
                       Margin="0,12,0,12"
                       Text="{Binding ValidationMessage}" />
            <Button HorizontalAlignment="Center"
                    MinWidth="140"
                    Click="OnSubmitClicked">Next</Button>
        </StackPanel>
    </Grid>
</pages:BasePage>
